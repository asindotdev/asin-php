{
    "name": "asindotdev/sdk",
    "description": "Official PHP SDK for the Asin Amazon price tracking API.",
    "type": "library",
    "keywords": [
        "amazon-api",
        "api",
        "asin",
        "price-history",
        "price-tracking",
        "sdk"
    ],
    "homepage": "https://www.asin.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Asin",
            "email": "contact@asin.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/asindotdev/asin-php/issues",
        "source": "https://github.com/asindotdev/asin-php",
        "docs": "https://www.asin.dev/docs"
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Asin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ],
        "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "test": "phpunit --configuration=phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}
